# Existing shared Supabase project; use only the public client key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
APP_ORIGIN=http://localhost:3000

# Preserve the existing hosted app until the new People schema is reviewed/provisioned.
NEXT_PUBLIC_LOCAL_AUTH=false
# HANDSIN_PEOPLE_FOUNDATION=ready

# The isolated local People runner writes .env.local itself.
# See docs/CONNECTED_PEOPLE_LOCAL.md for local backend requirements.
